# Copy to `.env.local` and restart the dev server.
#
# Leave this unset to run the built-in sandbox payment simulator, which auto-settles
# each KHQR after ~12-26 seconds and exposes the "simulate payer" controls.
#
# Set it to a service that implements:
#   POST {base}/payment-intents                       -> creates an intent
#   GET  {base}/payment-intents/:billNumber/status    -> { status, paidAt?, method? }
#
# VITE_PAYMENT_API_BASE=https://api.your-host.example/v1
